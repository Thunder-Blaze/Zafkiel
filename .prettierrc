{
	"useTabs": true,
	"singleQuote": true,
    "tabWidth": 2,
    "semi": true,
	"trailingComma": "es5",
	"printWidth": 100,
    "arrowParens": "always",
	"plugins": ["prettier-plugin-svelte", "prettier-plugin-tailwindcss"],
	"overrides": [
		{
			"files": "*.svelte",
			"options": {
				"parser": "svelte"
			}
		}
	],
	"tailwindStylesheet": "./src/app.css",
    "svelteIndentScriptAndStyle": true
}
