{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "Zafkiel",
	"version": "0.1.0",
	"identifier": "com.zafkiel.dev",
	"build": {
		"frontendDist": "../build",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "bun dev",
		"beforeBuildCommand": "bun run build"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Zafkiel",
				"width": 1200,
				"height": 800,
				"minWidth": 800,
				"minHeight": 600,
				"resizable": true,
				"fullscreen": false,
				"decorations": false,
				"transparent": true,
				"zoomHotkeysEnabled": false
			}
		],
		"security": {
			"csp": null,
			"devCsp": null,
			"assetProtocol": {
				"enable": true,
				"scope": ["$RESOURCE/**", "$CONFIG/**", "$DATA/**", "$APPDATA/**", "$LOCALDATA/**"]
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"resources": {
			"../static/themes/": "themes/",
			"lib/": "lib/",
			"shaders/": "shaders/"
		}
	}
}
