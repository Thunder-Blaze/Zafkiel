{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "Zafkiel",
	"version": "0.1.0",
	"identifier": "com.zafkiel.dev",
	"build": {
		"frontendDist": "../build",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "bun dev",
		"beforeBuildCommand": "bun run build"
	},
	"app": {
		"windows": [
			{
				"title": "Zafkiel",
				"width": 1200,
				"height": 800,
				"minWidth": 800,
				"minHeight": 600,
				"resizable": true,
				"fullscreen": false,
				"decorations": false,
				"transparent": false,
				"zoomHotkeysEnabled": false
			}
		],
		"security": {
			"csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests; block-all-mixed-content",
			"devCsp": null,
			"assetProtocol": {
				"enable": true,
				"scope": [
					"$RESOURCE/**",
					"$CONFIG/**",
					"$DATA/**",
					"$APPDATA/**",
					"$LOCALDATA/**"
				]
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"resources": {
			"../static/themes/": "themes/"
		}
	}
}
